{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Rasid.Server.Workers.JobPollingWorker": "Information",
            "Rasid.Server.Workers.ScrapeCycleRunner": "Information"
        }
    },
    "AllowedHosts": "*",
    "Urls": "http://localhost:5000;https://localhost:5001",
    "JobScraper": {
        "InitialDelaySeconds": 5,
        "CheckIntervalSeconds": 60,
        "MaxSeenJobs": 5000,
        "MaxConcurrentEnrichmentsPerPlatform": 3,
        "KhamsatPublishFreshnessHours": 48,
        "DbPath": "seen_jobs.db",
        "UseInMemoryCache": false,
        "SeenJobRetentionDays": 14
    },
    "Crawler": {
        "EnableHeadlessFallback": true,
        "PerDomainDelayMilliseconds": 1000,
        "JitterMaxMilliseconds": 500,
        "RequestTimeoutSeconds": 20,
        "MaxRetries": 3
    },
    "Cors": {
        "Mode": "AllowAll",
        "AllowedOrigins": []
    },
    "AdminToken": "change-me-in-production"
}
